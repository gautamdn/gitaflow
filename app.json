{
  "expo": {
    "name": "GitaFlow",
    "slug": "gitaflow",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "gitaflow",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6F00"
    },
    "ios": {
      "bundleIdentifier": "com.gitaflow.app",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gitaflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6F00"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "GitaFlow needs microphone access for pronunciation practice."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41d844c1-bed2-49e5-8ae0-02c93ce7d3f3"
      }
    },
    "owner": "gautamdn"
  }
}
